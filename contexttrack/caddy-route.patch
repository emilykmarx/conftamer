+// ConfTamer: helpers for the "Request routed" hook in routes.go (wrapRoute).
+
+package caddyhttp
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/caddyserver/caddy/v2"
+)
+
+// conftamerRoutePattern describes a route's matchers as a pattern for
+// http.ConftamerLogRouted: each matcher as <module name>=<its JSON config>
+// (e.g. path=["/api/*"]), matchers in a set joined by " && ", and sets by
+// " || ". A route without matchers matches everything: "*". (The matchers'
+// raw JSON is cleared once they're loaded, so this re-marshals them.)
+func conftamerRoutePattern(sets MatcherSets) string {
+	if len(sets) == 0 {
+		return "*"
+	}
+	var b strings.Builder
+	for i, set := range sets {
+		if i > 0 {
+			b.WriteString(" || ")
+		}
+		for j, m := range set {
+			if j > 0 {
+				b.WriteString(" && ")
+			}
+			name := fmt.Sprintf("%T", m)
+			if mod, ok := m.(caddy.Module); ok {
+				name = mod.CaddyModule().ID.Name()
+			}
+			b.WriteString(name)
+			if cfg, err := json.Marshal(m); err == nil {
+				b.WriteByte('=')
+				b.Write(cfg)
+			}
+		}
+	}
+	return b.String()
+}
