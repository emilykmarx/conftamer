@@ -0,0 +1,59 @@
+package grpc
+
+import (
+	"context"
+	"net/http"
+	"strings"
+
+	"google.golang.org/grpc/internal/transport"
+)
+
+// conftamerHandler is the registered method that handleStream dispatches a
+// request for path ("/service/method") to: the method's generated handler (e.g.
+// etcdserverpb._KV_Range_Handler), or nil for an unknown service or method.
+func (s *Server) conftamerHandler(path string) any {
+	sm := strings.TrimPrefix(path, "/")
+	pos := strings.LastIndex(sm, "/")
+	if pos == -1 {
+		return nil
+	}
+	srv, ok := s.services[sm[:pos]]
+	if !ok {
+		return nil
+	}
+	if md, ok := srv.methods[sm[pos+1:]]; ok {
+		return md.Handler
+	}
+	if sd, ok := srv.streams[sm[pos+1:]]; ok {
+		return sd.Handler
+	}
+	return nil
+}
+
+// conftamerLogRouted logs, as "Request routed", the registered method that
+// handleStream will dispatch r to, for requests served via ServeHTTP (those
+// reached s through net/http, which logged their "Request received"). The
+// pattern is the full method name (r's path); the handler, the method's
+// (conftamerHandler). Unknown services and methods aren't logged, so they keep
+// the pattern of the router that passed r to s.
+func (s *Server) conftamerLogRouted(r *http.Request) {
+	if handler := s.conftamerHandler(r.URL.Path); handler != nil {
+		http.ConftamerLogRouted(r.URL.Path, r, handler)
+	}
+}
+
+// conftamerLogOwnTransport logs "Request received" and "Request routed" for a
+// request on grpc-go's own transport (Serve; internal/transport/conftamer.go),
+// which net/http never saw: with the method's handler, so they're identified as
+// the ServeHTTP path's are. Not for other streams (ServeHTTP's: logged already).
+func (s *Server) conftamerLogOwnTransport(ctx context.Context, stream *transport.Stream) {
+	if !transport.ConftamerOwnTransport(ctx) {
+		return
+	}
+	path := stream.Method()
+	handler := s.conftamerHandler(path)
+	http.ConftamerLogServerReceived(ctx, http.MethodPost, path, "", handler)
+	if handler != nil {
+		http.ConftamerLogServerRouted(ctx, path, http.MethodPost, path, handler)
+	}
+}
