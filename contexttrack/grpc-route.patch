@@ -0,0 +1,48 @@
+package transport
+
+import (
+	"context"
+	"net/http"
+	"strings"
+
+	"google.golang.org/grpc/metadata"
+)
+
+// ConfTamer: requests on grpc-go's own HTTP/2 server (http2Server, as
+// Server.Serve runs it), which net/http never sees. Their context gets a context
+// ID and connection here (conftamerServerStream), "Response sent" is logged here
+// when their headers go out, and "Request received" and "Request routed" are
+// logged by Server.handleStream, which knows the method's handler
+// (ConftamerOwnTransport). Requests served via Server.ServeHTTP go through
+// net/http (and serverHandlerTransport) instead, which logs them.
+
+type conftamerOwnKeyType struct{}
+
+var conftamerOwnKey conftamerOwnKeyType
+
+// conftamerServerStream gives s's context a context ID, its method as the path,
+// its connection and HTTP/2 stream, and its User-Agent (from mdata), and marks
+// it as a stream of this transport.
+func (t *http2Server) conftamerServerStream(s *Stream, mdata metadata.MD) {
+	header := func(name string) string {
+		if v := mdata[strings.ToLower(name)]; len(v) > 0 {
+			return v[0]
+		}
+		return ""
+	}
+	ctx := http.ConftamerServerContext(s.ctx, s.method, t.conn.LocalAddr(), t.conn.RemoteAddr(), s.id, header)
+	s.ctx = context.WithValue(ctx, conftamerOwnKey, true)
+}
+
+// ConftamerOwnTransport reports whether ctx is that of a stream that arrived on
+// grpc-go's own HTTP/2 server (conftamerServerStream).
+func ConftamerOwnTransport(ctx context.Context) bool {
+	own, _ := ctx.Value(conftamerOwnKey).(bool)
+	return own
+}
+
+// conftamerResponseSent logs s's "Response sent", as its headers go out: their
+// :status is always 200 (gRPC's status is in the trailers).
+func conftamerResponseSent(s *Stream) {
+	http.ConftamerLogServerResponse(s.ctx, http.MethodPost, s.method, http.StatusOK)
+}
