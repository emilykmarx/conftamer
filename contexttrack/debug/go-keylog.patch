+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package tls
+
+import (
+	"io"
+	"os"
+	"sync"
+)
+
+// conftamerKeyLog returns the process-wide key log writer named by
+// $CONFTAMER_KEYLOG (NSS key log format, as for Config.KeyLogWriter), or nil
+// if it's unset or can't be opened. Used for every Config that sets no
+// KeyLogWriter of its own, so packet captures of any TLS connection the
+// process makes or accepts can be decrypted.
+var conftamerKeyLog = sync.OnceValue(func() io.Writer {
+	path := os.Getenv("CONFTAMER_KEYLOG")
+	if path == "" {
+		return nil
+	}
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0644)
+	if err != nil {
+		return nil
+	}
+	return f
+})
