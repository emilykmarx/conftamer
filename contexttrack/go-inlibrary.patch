--- /dev/null
+++ b/home/tcr6/go-conftamer/src/net/http/conftamer.go
@@ -0,0 +1,853 @@
+// ConfTamer instrumentation embedded in net/http.
+//
+// At a handful of HTTP funnel points, records the message, resolves
+// the request context's conftamer ID, and tries to identify the "API ID"
+// (application-level caller).
+// A JSON object is appended to the file named by $CONFTAMER_EVENTS per event.
+// If $CONFTAMER_EVENTS is unset, every hook is a no-op.
+
+package http
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"reflect"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+var (
+	conftamerOnce    sync.Once
+	conftamerMu      sync.Mutex
+	conftamerFile    *os.File
+	conftamerEnabled bool
+	conftamerPath    string
+	conftamerOpenErr error
+)
+
+func conftamerInit() {
+	conftamerPath = os.Getenv("CONFTAMER_EVENTS")
+	if conftamerPath == "" {
+		return
+	}
+	f, err := os.OpenFile(conftamerPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+	if err != nil {
+		conftamerOpenErr = err
+		return
+	}
+	conftamerFile = f
+	conftamerEnabled = true
+}
+
+func conftamerOn() bool {
+	conftamerOnce.Do(conftamerInit)
+	return conftamerEnabled
+}
+
+// init prints a one-line diagnostic to stderr at process start whenever the
+// user opted in via CONFTAMER_EVENTS.
+// It runs eagerly (not lazily on the first hook) to make it easy to differentiate
+// between "file exists but no events at all" and "file doesn't exist".
+func init() {
+	if os.Getenv("CONFTAMER_EVENTS") == "" {
+		return
+	}
+	if conftamerOn() {
+		fmt.Fprintf(os.Stderr, "conftamer: enabled — writing %q\n", conftamerPath)
+	} else {
+		fmt.Fprintf(os.Stderr, "conftamer: CONFTAMER_EVENTS=%q set but open failed: %v\n", conftamerPath, conftamerOpenErr)
+	}
+}
+
+// --- event schema --------------------
+
+type conftamerEvent struct {
+	Kind        string                `json:"kind"`
+	Ts          int64                 `json:"ts"` // Unix ns
+	Pid         int                   `json:"pid"`
+	GoroutineID int                   `json:"goroutine_id"`
+	ThreadID    int                   `json:"thread_id"`
+	File        string                `json:"file"`
+	Line        int                   `json:"line"`
+	Message     map[string]string     `json:"message"`
+	Context     *conftamerContextInfo `json:"context"`
+	RequestID   *conftamerRequestID   `json:"request_id,omitempty"`
+	ApiId       string                `json:"api_id,omitempty"`
+	// Ancestry and Stack describe the goroutine that logged the event (see
+	// conftamerSplitStack): Ancestry is the same for every event it logs, and
+	// Stack is what it was running, starting at the function that logged it.
+	Ancestry string `json:"ancestry"`
+	Stack    string `json:"stack"`
+	// Handler is the name of the Handler serving a "Request received" event, or
+	// the Handler a ServeMux routed a "Request routed" event to.
+	// Not set on "Response sent".
+	Handler string `json:"handler,omitempty"`
+	// CallChain is the full stack at the event, innermost frame first, starting
+	// at the function that logged it.
+	CallChain []conftamerFrame `json:"call_chain,omitempty"`
+	// Conn is the connection a request went over, on "Request received",
+	// "Request routed" and "Response sent" (server side), and, with
+	// contexttrack's debug/go-inlibrary-conn.patch, on "Request sent" (client
+	// side).
+	Conn *conftamerConnInfo `json:"conn,omitempty"`
+	// UserAgent is the request's User-Agent header, on the server side's events
+	// (with Conn): what the client says it is, e.g. a testbed's workload tagging
+	// its requests. Not part of Message, so not of the message's label.
+	UserAgent string `json:"user_agent,omitempty"`
+}
+
+// conftamerConnInfo is a connection as this end's socket sees it, and which
+// message on it this is: what a packet capture at this end sees.
+type conftamerConnInfo struct {
+	Local  string `json:"local"`
+	Remote string `json:"remote"`
+	// Index: HTTP/1 only, the request's position on the connection, from 0.
+	Index *int `json:"index,omitempty"`
+	// H2Stream: HTTP/2 only (the server side, and gRPC clients; net/http's HTTP/2
+	// client doesn't know it).
+	H2Stream uint32 `json:"h2_stream,omitempty"`
+	// userAgent: the server side's request's User-Agent header, logged as the
+	// event's user_agent (conftamerEvent.UserAgent), not as part of conn.
+	userAgent string
+}
+
+// withUserAgent records r's User-Agent header in i (server side), and returns i.
+func (i *conftamerConnInfo) withUserAgent(r *Request) *conftamerConnInfo {
+	i.userAgent = r.Header.Get("User-Agent")
+	return i
+}
+
+// conftamerNewConnInfo describes c; index < 0 means none (HTTP/2).
+func conftamerNewConnInfo(c net.Conn, index int, h2Stream uint32) *conftamerConnInfo {
+	info := &conftamerConnInfo{Local: c.LocalAddr().String(), Remote: c.RemoteAddr().String(), H2Stream: h2Stream}
+	if index >= 0 {
+		info.Index = &index
+	}
+	return info
+}
+
+// The server side records a request's connection in its context, so the
+// events logged from the Request (or a shallow copy a router makes) find it.
+type conftamerConnKeyType struct{}
+
+var conftamerConnKey conftamerConnKeyType
+
+func conftamerWithConn(ctx context.Context, info *conftamerConnInfo) context.Context {
+	return context.WithValue(ctx, conftamerConnKey, info)
+}
+
+// conftamerEnsureServerContext gives r a context ID and its connection's
+// addresses (no index or stream: not known here), if it lacks them: a request
+// built by a server outside net/http without the ConftamerServerRequest hook.
+func conftamerEnsureServerContext(r *Request) *Request {
+	if !conftamerOn() {
+		return r
+	}
+	ctx := r.Context()
+	_, hasID := ctx.Value(conftamerIDKey).(uint64)
+	if hasID && conftamerServerConn(ctx) != nil {
+		return r
+	}
+	if !hasID {
+		ctx = conftamerStampServer(ctx, r.URL.Path)
+	}
+	if conftamerServerConn(ctx) == nil {
+		if local, ok := ctx.Value(LocalAddrContextKey).(net.Addr); ok && r.RemoteAddr != "" {
+			ctx = conftamerWithConn(ctx, (&conftamerConnInfo{Local: local.String(), Remote: r.RemoteAddr}).withUserAgent(r))
+		}
+	}
+	return r.WithContext(ctx)
+}
+
+// conftamerH2LogsReceived reports whether the bundled HTTP/2 server's
+// runHandler should log "Request received" for a connection served by h: not
+// when h is net/http's own HTTP/2 server's (TLS with ALPN, or unencrypted
+// HTTP/2), which hands requests to serverHandler.ServeHTTP, which logs it.
+func conftamerH2LogsReceived(h Handler) bool {
+	switch h.(type) {
+	case initALPNRequest, unencryptedHTTP2Request:
+		return false
+	}
+	return true
+}
+
+// conftamerServerConn returns the connection a server-side request arrived on.
+// Only for server-side events: a handler's outgoing requests inherit its
+// context, but go over a different connection.
+func conftamerServerConn(ctx context.Context) *conftamerConnInfo {
+	info, _ := ctx.Value(conftamerConnKey).(*conftamerConnInfo)
+	return info
+}
+
+type conftamerFrame struct {
+	Function string `json:"function"`
+	File     string `json:"file"`
+	Line     int    `json:"line"`
+}
+
+type conftamerRequestID struct {
+	Method string `json:"method"`
+	Host   string `json:"host"`
+	Path   string `json:"path"`
+}
+
+type conftamerContextInfo struct {
+	Source    string `json:"source,omitempty"`
+	Type      string `json:"type,omitempty"`
+	ContextID string `json:"context_id,omitempty"`
+	Error     string `json:"error,omitempty"`
+}
+
+// --- context ID (correlation key) -----------------------------------------
+//
+// An explicit, process-local, monotonically-increasing request ID stamped
+// into the request context at its origin and inherited by every derived context.
+// conftamerIDKey is the context.Value key for the stamped request ID.
+// It's unexported to avoid colliding with other context.Value keys.
+type conftamerIDKeyType struct{}
+
+var (
+	conftamerIDKey  conftamerIDKeyType
+	conftamerNextID atomic.Uint64 // Next to assign
+)
+
+// conftamerStampID returns ctx unchanged if it already carries an ID
+// (inherited from an ancestor), else a child context carrying a fresh
+// monotonic ID.
+func conftamerStampID(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if _, ok := ctx.Value(conftamerIDKey).(uint64); ok {
+		return ctx
+	}
+	return context.WithValue(ctx, conftamerIDKey, conftamerNextID.Add(1))
+}
+
+// conftamerStampIDIfOn is conftamerStampID gated on the logger being enabled.
+func conftamerStampIDIfOn(ctx context.Context) context.Context {
+	if !conftamerOn() {
+		return ctx
+	}
+	return conftamerStampID(ctx)
+}
+
+// conftamerRecvPathKey is the context.Value key for the path a server received
+// a request with (conftamerStampServer).
+type conftamerRecvPathKeyType struct{}
+
+var conftamerRecvPathKey conftamerRecvPathKeyType
+
+// conftamerStampServer is conftamerStampIDIfOn for a request a server just
+// received, before any handler runs: it also records the request's path, so
+// "Response sent" can log it (conftamerRecvPath). Handlers can change the
+// request's own fields in place, e.g. Grafana's router strips its sub path from
+// req.URL.Path (pkg/web/macaron.go), Prometheus's pprof handler rewrites it
+// (web/web.go), and Caddy's rewrite handler sets both req.URL and
+// req.RequestURI (modules/caddyhttp/rewrite/rewrite.go); a context value under
+// an unexported key, they can't.
+func conftamerStampServer(ctx context.Context, path string) context.Context {
+	if !conftamerOn() {
+		return ctx
+	}
+	return context.WithValue(conftamerStampID(ctx), conftamerRecvPathKey, path)
+}
+
+// conftamerRecvPath is the path r's server received it with (conftamerStampServer),
+// or r.URL.Path if none was recorded.
+func conftamerRecvPath(r *Request) string {
+	if p, ok := r.Context().Value(conftamerRecvPathKey).(string); ok {
+		return p
+	}
+	return r.URL.Path
+}
+
+// conftamerHijackedConn wraps the connection Hijack returns to a handler that
+// hasn't written a header (so no "Response sent" was logged), e.g. a WebSocket
+// upgrader that writes "HTTP/1.1 101 Switching Protocols" itself: it logs
+// "Response sent" with the status code of the first line written, if that line
+// is an HTTP status line, and then only passes writes through.
+type conftamerHijackedConn struct {
+	net.Conn
+	req  *Request
+	mu   sync.Mutex
+	line []byte // the first line written so far
+	done bool
+}
+
+// conftamerMaxStatusLine bounds how much of the first write is kept looking for
+// the status line's end.
+const conftamerMaxStatusLine = 128
+
+func (c *conftamerHijackedConn) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	if !c.done {
+		c.line = append(c.line, p[:min(len(p), conftamerMaxStatusLine-len(c.line))]...)
+		if i := strings.Index(string(c.line), "\r\n"); i >= 0 || len(c.line) >= conftamerMaxStatusLine {
+			c.done = true
+			if i < 0 {
+				i = len(c.line)
+			}
+			c.logStatus(string(c.line[:i]))
+			c.line = nil
+		}
+	}
+	c.mu.Unlock()
+	return c.Conn.Write(p)
+}
+
+// logStatus logs "Response sent" if line is an HTTP status line ("HTTP/1.1 101 Switching Protocols")
+func (c *conftamerHijackedConn) logStatus(line string) {
+	proto, rest, ok := strings.Cut(line, " ")
+	if !ok || !strings.HasPrefix(proto, "HTTP/") || len(rest) < 3 {
+		return
+	}
+	code, err := strconv.Atoi(rest[:3])
+	if err != nil {
+		return
+	}
+	// No caller identification: see conftamerLog.
+	conftamerLog("Response sent", map[string]string{
+		"code":         strconv.Itoa(code),
+		"req.Method":   c.req.Method,
+		"req.URL.Path": conftamerRecvPath(c.req),
+	}, c.req.Context(), nil, false, nil, conftamerServerConn(c.req.Context()))
+}
+
+func conftamerContext(ctx context.Context) *conftamerContextInfo {
+	if ctx == nil {
+		return &conftamerContextInfo{Error: "nil context"}
+	}
+	id, ok := ctx.Value(conftamerIDKey).(uint64)
+	if !ok {
+		id = conftamerNextID.Add(1)
+	}
+	return &conftamerContextInfo{
+		Source:    "req.Context()",
+		Type:      "context.Context",
+		ContextID: "id:" + strconv.FormatUint(id, 10),
+	}
+}
+
+// --- caller (API_ID) identification ----------------------
+
+// Generic HTTP plumbing (client wrappers, routers) that can't identify the API.
+// true: also skip subpackages and major versions (e.g. go-restful/v3).
+var conftamerHTTPLayerPackages = map[string]bool{
+	"net/http":                         false,
+	"net/http/httputil":                false,
+	"golang.org/x/net/http2":           false,
+	"golang.org/x/oauth2":              true,
+	"golang.org/x/net/context/ctxhttp": true,
+	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp": true,
+	"github.com/prometheus/common/route":                            true,
+	"github.com/emicklei/go-restful":                                true,
+	"github.com/gorilla/mux":                                        true,
+	"k8s.io/apiserver/pkg/server/mux":                               true,
+	"github.com/grafana/grafana/pkg/web":                            true,
+	"google.golang.org/grpc":                                        true,
+}
+
+func conftamerIsHTTPLayer(pkg string) bool {
+	for p, subpkgs := range conftamerHTTPLayerPackages {
+		if pkg == p || subpkgs && strings.HasPrefix(pkg, p+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+var conftamerMultiTenantHosts = map[string]bool{
+	"github.com":    true,
+	"gitlab.com":    true,
+	"bitbucket.org": true,
+}
+
+type conftamerCaller struct {
+	FuncName string
+	Package  string
+	ApiId    string
+}
+
+// tries to extract the import path from a runtime fully-qualified
+// function name, e.g. "github.com/prometheus/prometheus/scrape.(*x).scrape" ->
+// "github.com/prometheus/prometheus/scrape".
+// The boundary is: drop any "[...]" generic suffix, find the last "/", then the
+// first "." after it.
+func conftamerPackageName(fullName string) string {
+	name := fullName
+	if start := strings.Index(name, "["); start >= 0 {
+		name = name[:start]
+	}
+	pathEnd := strings.LastIndex(name, "/")
+	if pathEnd < 0 {
+		pathEnd = 0
+	}
+	if dot := strings.Index(name[pathEnd:], "."); dot >= 0 {
+		return name[:pathEnd+dot]
+	}
+	return ""
+}
+
+// Derives an API id from a package import path, e.g.
+// "github.com/prometheus/prometheus/scrape" -> "github.com/prometheus",
+// "k8s.io/client-go/rest" -> "k8s.io". Stdlib paths (no dot in the first
+// segment) returned unchanged.
+func conftamerApiID(pkg string) string {
+	if pkg == "" {
+		return ""
+	}
+	segs := strings.SplitN(pkg, "/", 3)
+	if !strings.Contains(segs[0], ".") {
+		return pkg
+	}
+	if len(segs) >= 2 && conftamerMultiTenantHosts[segs[0]] {
+		return segs[0] + "/" + segs[1]
+	}
+	return segs[0]
+}
+
+// Walks the current goroutine's stack and returns the first
+// frame whose package is not in "conftamerHTTPLayerPackages"
+// (inferred to be "generic helpers" and not the calling applciation).
+func conftamerFindCaller() *conftamerCaller {
+	var pcs [50]uintptr
+	n := runtime.Callers(2, pcs[:])
+	if n == 0 {
+		return nil
+	}
+	frames := runtime.CallersFrames(pcs[:n])
+	for {
+		f, more := frames.Next()
+		pkg := conftamerPackageName(f.Function)
+		if pkg != "" && !conftamerIsHTTPLayer(pkg) {
+			return &conftamerCaller{FuncName: f.Function, Package: pkg, ApiId: conftamerApiID(pkg)}
+		}
+		if !more {
+			break
+		}
+	}
+	return nil
+}
+
+// conftamerHandlerCaller identifies the API ID from a not-yet-invoked Handler
+// value. Used for "Request received", where the stack doesn't include the
+// application handler.
+func conftamerHandlerCaller(handler any) *conftamerCaller {
+	if handler == nil {
+		return nil
+	}
+   // get "real" type if this is stored as "any"
+	v := reflect.ValueOf(handler)
+	var pkg, name string
+	if v.Kind() == reflect.Func { // e.g., `http.HandlerFunc(...)`
+       // Get function pointer -> look up address in `runtime` to get func metadata
+		if fn := runtime.FuncForPC(v.Pointer()); fn != nil {
+			name = fn.Name()
+			pkg = conftamerPackageName(name)
+		}
+	} else { // e.g., method on a type
+		t := v.Type()
+		for t.Kind() == reflect.Ptr {
+			t = t.Elem()
+		}
+       // Look for package where type is defined
+		pkg = t.PkgPath()
+		name = t.String()
+	}
+	if pkg == "" || conftamerIsHTTPLayer(pkg) {
+		return nil
+	}
+	return &conftamerCaller{FuncName: name, Package: pkg, ApiId: conftamerApiID(pkg)}
+}
+
+// --- metadata --------------------------------------------------------------
+
+func conftamerGoID() int {
+	var buf [64]byte
+	n := runtime.Stack(buf[:], false)
+	s := string(buf[:n])
+	s = strings.TrimPrefix(s, "goroutine ")
+	if i := strings.IndexByte(s, ' '); i >= 0 {
+		id, _ := strconv.Atoi(s[:i])
+		return id
+	}
+	return 0
+}
+
+// conftamerCallChain returns every frame of the current goroutine's stack, innermost
+// first, skipping `skip` frames above its caller (0 = start at the caller).
+// The buffer grows until the whole stack fits, so deep stacks aren't truncated.
+func conftamerCallChain(skip int) []conftamerFrame {
+	pcs := make([]uintptr, 64)
+	var n int
+	for {
+		// +2 skips runtime.Callers and conftamerCallChain itself
+		n = runtime.Callers(skip+2, pcs)
+		if n < len(pcs) {
+			break
+		}
+		pcs = make([]uintptr, 2*len(pcs))
+	}
+	chain := make([]conftamerFrame, 0, n)
+	frames := runtime.CallersFrames(pcs[:n])
+	for {
+		f, more := frames.Next()
+		chain = append(chain, conftamerFrame{Function: f.Function, File: f.File, Line: f.Line})
+		if !more {
+			break
+		}
+	}
+	return chain
+}
+
+// conftamerGoroutineStack returns runtime.Stack's output for the calling
+// goroutine, whole.
+func conftamerGoroutineStack() string {
+	buf := make([]byte, 64<<10)
+	for {
+		n := runtime.Stack(buf, false)
+		if n < len(buf) {
+			return string(buf[:n])
+		}
+		buf = make([]byte, 2*len(buf))
+	}
+}
+
+// conftamerSplitStack splits s, runtime.Stack's output for one goroutine, into
+// the goroutine's ancestry and its stack, and leaves out the frames at the top
+// of the stack whose function skip reports true (the logger's own frames).
+//
+// The ancestry is the goroutine's ID line without its state ("goroutine 8"),
+// followed by the rest of s from its "created by" line: where the goroutine
+// was created, and, with GODEBUG=tracebackancestors=N, the stacks of its
+// ancestors when they created their children ("[originating from goroutine
+// 7]:" sections). It's the same at every point in the goroutine, so it can be
+// used to join records made in the same goroutine. The stack is s's first line
+// and the frames before "created by", i.e. what the goroutine is running.
+//
+// argmatch (dump_ancestors/argmatch, splitStack in rt/rt.go) splits the stacks
+// of the calls it checks in the same way, so the ancestries in the two outputs can be
+// compared; keep the two in step.
+func conftamerSplitStack(s string, skip func(fn string) bool) (ancestry, stack string) {
+	first, rest, _ := strings.Cut(s, "\n")
+	id, _, _ := strings.Cut(first, " [")
+	frames, lineage := rest, ""
+	if i := strings.Index("\n"+rest, "\ncreated by "); i >= 0 {
+		frames, lineage = rest[:i], rest[i:]
+	}
+	// Each frame is a function line, e.g. "main.f(0x1, ...)", then a file line.
+	for frames != "" {
+		fn, after, _ := strings.Cut(frames, "\n")
+		if i := strings.LastIndex(fn, "("); i >= 0 {
+			fn = fn[:i]
+		}
+		if !skip(fn) {
+			break
+		}
+		_, frames, _ = strings.Cut(after, "\n")
+	}
+	ancestry = id
+	if lineage = strings.TrimRight(lineage, "\n"); lineage != "" {
+		ancestry += "\n" + lineage
+	}
+	return ancestry, first + "\n" + strings.TrimRight(frames, "\n")
+}
+
+// conftamerIsLogger reports whether fn, a function named as in a stack trace,
+// is part of the logger rather than the function that logged an event (the
+// frames conftamerLogAt leaves out of CallChain, and the function that calls
+// runtime.Stack).
+func conftamerIsLogger(fn string) bool {
+	switch fn {
+	case "net/http.conftamerGoroutineStack", "net/http.conftamerLog", "net/http.conftamerLogAt":
+		return true
+	}
+	return false
+}
+
+// conftamerSentKey's value (a *conftamerSent, conftamerWithSent) records the
+// "Request sent" logged with the context, so that Client.do logs "Response
+// received" only for requests that went on the wire (through net/http's
+// Transport, Request.Write on a connection, or a client outside net/http that
+// logs: ConftamerLogClientRequest), and not for an in-process RoundTripper that
+// calls a handler directly (e.g. Grafana's client of its own API server), whose
+// request isn't logged either; and with the method and path that were sent,
+// which a RoundTripper can rewrite (e.g. kube-apiserver's OIDC discovery URL)
+// and a redirect changes, so that it pairs with that request and with the
+// transport's own "Response received" (analysis' dedup_responses).
+type conftamerSentKeyType struct{}
+
+var conftamerSentKey conftamerSentKeyType
+
+type conftamerSent struct {
+	mu           sync.Mutex
+	sent         bool
+	method, path string // the last request logged as sent
+}
+
+// conftamerWithSent returns ctx with a fresh conftamerSent under conftamerSentKey, and it.
+func conftamerWithSent(ctx context.Context) (context.Context, *conftamerSent) {
+	s := new(conftamerSent)
+	return context.WithValue(ctx, conftamerSentKey, s), s
+}
+
+func (s *conftamerSent) record(method, path string) {
+	s.mu.Lock()
+	s.sent, s.method, s.path = true, method, path
+	s.mu.Unlock()
+}
+
+// get returns the method and path last logged as sent, and whether any was.
+func (s *conftamerSent) get() (method, path string, ok bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.method, s.path, s.sent
+}
+
+// conftamerLogRequestWrite logs "Request sent" for r written by Request.Write
+// or WriteProxy, if w is a connection (not, e.g., a buffer being dumped to): a
+// client that dials and writes its request itself, such as client-go's SPDY
+// RoundTripper (kubectl exec and port-forward, kube-apiserver to the kubelet).
+func conftamerLogRequestWrite(r *Request, w io.Writer) {
+	if !conftamerOn() || r.URL == nil {
+		return
+	}
+	if _, ok := w.(net.Conn); !ok {
+		return
+	}
+	host := r.Host
+	if host == "" {
+		host = r.URL.Host
+	}
+	conftamerLogAt(2, time.Now(), "Request sent", map[string]string{
+		"req.Method":       r.Method,
+		"req.URL.Host":     host,
+		"req.URL.Path":     r.URL.Path,
+		"req.URL.RawQuery": r.URL.RawQuery,
+	}, r.Context(), &conftamerRequestID{Method: r.Method, Host: host, Path: r.URL.Path}, true, nil, nil)
+}
+
+// --- logging entry point -----------------------------------------------
+
+// conftamerLog records one HTTP event. ctx is the context with ID used for correlation.
+// reqID (may be nil) is set for "Request sent". withCaller enables caller identification.
+// handler (non-nil only for "Request received" and "Request routed") is the not-yet-invoked
+// Handler about to serve the request — when set, it's used instead of a stack walk, since
+// the application handler isn't on the stack yet at that log point, and its name is
+// recorded as Handler. conn (may be nil) is the connection the message went over.
+//
+// "Response sent" deliberately does NOT identify a caller: at the point a response is
+// written, the stack holds whatever the handler last called (fmt.Fprintln,
+// gzip.(*Writer).Write), not the handler itself, so the walk yields a misleading API.
+// Responses record only their code plus the method/path of the request they answer;
+// analysis (contexttrack/analysis/message_graph.py) recovers api_id/handler by matching
+// each response back to the "Request received" it answers, and the matched route pattern
+// from the "Request routed" events logged by conftamerLogRouted.
+func conftamerLog(kind string, msg map[string]string, ctx context.Context, reqID *conftamerRequestID, withCaller bool, handler any, conn *conftamerConnInfo) {
+	conftamerLogAt(2, time.Now(), kind, msg, ctx, reqID, withCaller, handler, conn)
+}
+
+// conftamerLogAt is conftamerLog for an event that happened at ts, logged by
+// the function skip frames up (1: conftamerLogAt's caller).
+func conftamerLogAt(skip int, ts time.Time, kind string, msg map[string]string, ctx context.Context, reqID *conftamerRequestID, withCaller bool, handler any, conn *conftamerConnInfo) {
+	if !conftamerOn() {
+		return
+	}
+	if kind == "Request sent" && ctx != nil {
+		if sent, ok := ctx.Value(conftamerSentKey).(*conftamerSent); ok {
+			sent.record(msg["req.Method"], msg["req.URL.Path"])
+		}
+	}
+
+	_, file, line, _ := runtime.Caller(skip)
+
+	ev := conftamerEvent{
+		Kind:        kind,
+		Ts:          ts.UnixNano(),
+		Pid:         os.Getpid(),
+		GoroutineID: conftamerGoID(),
+		File:        file,
+		Line:        line,
+		Message:     msg,
+		Context:     conftamerContext(ctx),
+		Conn:        conn,
+	}
+	if conn != nil {
+		ev.UserAgent = conn.userAgent
+	}
+
+	if withCaller {
+		var c *conftamerCaller
+		if handler != nil {
+			c = conftamerHandlerCaller(handler)
+		} else {
+			c = conftamerFindCaller()
+		}
+		if c != nil {
+			ev.ApiId = c.ApiId
+			if handler != nil {
+				ev.Handler = c.FuncName
+			}
+		}
+	}
+	if kind == "Request sent" {
+		ev.RequestID = reqID
+	}
+	// Skip conftamerLog(At), so the chain starts at the function that logged
+	// the event (Transport.roundTrip, serverHandler.ServeHTTP, conftamerLogRouted, ...)
+	ev.CallChain = conftamerCallChain(skip)
+	ev.Ancestry, ev.Stack = conftamerSplitStack(conftamerGoroutineStack(), conftamerIsLogger)
+
+	linebytes, err := json.Marshal(ev)
+	if err != nil {
+		return
+	}
+	conftamerMu.Lock()
+	conftamerFile.Write(append(linebytes, '\n'))
+	conftamerMu.Unlock()
+}
+
+// conftamerLogRouted records the route pattern a ServeMux matched for r, logged from
+// ServeMux.ServeHTTP because that's the only point the pattern is reliably in hand:
+// "Request received" fires before any routing happens, and by "Response sent" a nested
+// mux's pattern has been written to a shallow request copy (see StripPrefix) that the
+// ResponseWriter's request never sees. Nested muxes each log, sharing the request's
+// context ID, so the last one recorded is the innermost — the most specific match.
+// An empty pattern (no route matched) is not logged.
+//
+// handler (may be nil) is what the pattern routes to: a Handler, or a router's own
+// handler type (any func or value works). When set, the API ID is identified from it,
+// as for "Request received": a server whose top-level Handler is a ServeMux gets no
+// API ID there (net/http is an HTTP-layer package), but the handler the mux
+// dispatches to is the application's.
+func conftamerLogRouted(pattern string, r *Request, handler any) {
+	if pattern == "" {
+		return
+	}
+	conftamerLog("Request routed", map[string]string{
+		"pattern":      pattern,
+		"req.Method":   r.Method,
+		"req.URL.Path": r.URL.Path,
+	}, r.Context(), nil, handler != nil, handler, conftamerServerConn(r.Context()))
+}
+
+// ConftamerLogRouted records a route pattern matched by a router outside this
+// package — see conftamerLogRouted. Exported because a router such as
+// prometheus/common/route does its own matching, and can reach neither the
+// unexported logger nor the context ID it correlates on.
+// handler should be the application's handler for the route, not a wrapper the
+// router adds around it (middleware, instrumentation), so the API ID names the app.
+func ConftamerLogRouted(pattern string, r *Request, handler any) {
+	conftamerLogRouted(pattern, r, handler)
+}
+
+// Response received; as close as possible to socket.
+// No caller ID: read loop runs on its own goroutine, so api_id is not on stack.
+// r may be nil (HTTP/2 client stream carries only a context).
+func conftamerLogResponseWire(kind string, code int, ctx context.Context, r *Request) {
+	if !conftamerOn() {
+		return
+	}
+	codeKey := "code"
+	if kind == "Response received" {
+		codeKey = "resp.StatusCode"
+	}
+	msg := map[string]string{codeKey: strconv.Itoa(code)}
+	if r != nil {
+		msg["req.Method"] = r.Method
+		if r.URL != nil {
+			msg["req.URL.Path"] = r.URL.Path
+		}
+		if ctx == nil {
+			ctx = r.Context()
+		}
+	}
+	conftamerLog(kind, msg, ctx, nil, false, nil, nil)
+}
+
+// --- hooks for HTTP implementations outside net/http ---------------------
+//
+// golang.org/x/net/http2's server and grpc-go's client (patched by
+// contexttrack/x-net-http2-server.sh and grpc-client.patch) can't reach the
+// unexported logger, so they log through these.
+
+// ConftamerStampContext returns ctx with a context ID (see conftamerStampID).
+func ConftamerStampContext(ctx context.Context) context.Context {
+	return conftamerStampIDIfOn(ctx)
+}
+
+// ConftamerServerRequest gives a request built outside net/http the context
+// ID and connection that conn.readRequest gives net/http's: c is the
+// connection it arrived on, h2Stream its HTTP/2 stream.
+func ConftamerServerRequest(r *Request, c net.Conn, h2Stream uint32) *Request {
+	if !conftamerOn() {
+		return r
+	}
+	ctx := conftamerStampServer(r.Context(), r.URL.Path)
+	if c != nil {
+		ctx = conftamerWithConn(ctx, conftamerNewConnInfo(c, -1, h2Stream).withUserAgent(r))
+	}
+	return r.WithContext(ctx)
+}
+
+// ConftamerLogRequestReceived logs "Request received" for a server outside
+// net/http, about to call handler. Not when handler is net/http's own (an
+// http.Server's TLSNextProto passes it), whose serverHandler.ServeHTTP logs it.
+func ConftamerLogRequestReceived(r *Request, handler Handler) {
+	switch handler.(type) {
+	case serverHandler, initALPNRequest:
+		return
+	}
+	conftamerLogAt(2, time.Now(), "Request received", map[string]string{
+		"req.Method":       r.Method,
+		"req.URL.Path":     r.URL.Path,
+		"req.URL.RawQuery": r.URL.RawQuery,
+	}, r.Context(), nil, true, handler, conftamerServerConn(r.Context()))
+}
+
+// ConftamerLogResponseSent logs "Response sent" for a server outside net/http.
+func ConftamerLogResponseSent(r *Request, code int) {
+	if r == nil {
+		return
+	}
+	// No caller identification: see conftamerLog.
+	conftamerLogAt(2, time.Now(), "Response sent", map[string]string{
+		"code":         strconv.Itoa(code),
+		"req.Method":   r.Method,
+		"req.URL.Path": conftamerRecvPath(r),
+	}, r.Context(), nil, false, nil, conftamerServerConn(r.Context()))
+}
+
+// ConftamerLogClientRequest logs "Request sent" for a client outside net/http
+// (grpc-go's). Its connection (local, remote) and HTTP/2 stream (h2Stream) are
+// recorded only with contexttrack's debug/go-inlibrary-conn.patch.
+func ConftamerLogClientRequest(ctx context.Context, method, host, path string, local, remote net.Addr, h2Stream uint32) {
+	if !conftamerOn() {
+		return
+	}
+	conftamerLogAt(2, time.Now(), "Request sent", map[string]string{
+		"req.Method":       method,
+		"req.URL.Host":     host,
+		"req.URL.Path":     path,
+		"req.URL.RawQuery": "",
+	}, ctx, &conftamerRequestID{Method: method, Host: host, Path: path}, true, nil, nil)
+}
+
+// ConftamerLogClientResponse logs "Response received" for a client outside
+// net/http. No caller ID: it's logged on the connection's reader goroutine.
+func ConftamerLogClientResponse(ctx context.Context, method, path string, code int) {
+	conftamerLogAt(2, time.Now(), "Response received", map[string]string{
+		"resp.StatusCode": strconv.Itoa(code),
+		"req.Method":      method,
+		"req.URL.Path":    path,
+	}, ctx, nil, false, nil, nil)
+}
