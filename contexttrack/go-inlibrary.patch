diff --git a/home/tcr6/go-conftamer/src/net/http/conftamer.go b/home/tcr6/go-conftamer/src/net/http/conftamer.go
new file mode 100644
index 0000000..9098c17
--- /dev/null
+++ b/home/tcr6/go-conftamer/src/net/http/conftamer.go
@@ -0,0 +1,326 @@
+// ConfTamer instrumentation embedded in net/http.
+//
+// This reproduces, in-process, what contexttrack/ previously did with a Delve
+// debugger: at a handful of HTTP funnel points it records the message, resolves
+// the request context's root address (the correlation join key), and — for
+// outbound events — identifies the application-level caller. One JSON object is
+// appended to the file named by $CONFTAMER_EVENTS per event, in the exact
+// schema the contexttrack/analysis/ scripts consume. If $CONFTAMER_EVENTS is
+// unset, every hook is a cheap no-op.
+//
+// Ported from contexttrack/client/main.go (event schema), context_finder.go
+// (ContextInfo, the parent-chain walk — now context.ConftamerRoot) and
+// caller_id.go (FindCaller / packageName / apiIdForPackage).
+
+package http
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+)
+
+// --- output sink -----------------------------------------------------------
+
+var (
+	conftamerOnce    sync.Once
+	conftamerMu      sync.Mutex
+	conftamerFile    *os.File
+	conftamerEnabled bool
+	conftamerPath    string
+	conftamerOpenErr error
+)
+
+func conftamerInit() {
+	conftamerPath = os.Getenv("CONFTAMER_EVENTS")
+	if conftamerPath == "" {
+		return
+	}
+	f, err := os.OpenFile(conftamerPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+	if err != nil {
+		conftamerOpenErr = err
+		return
+	}
+	conftamerFile = f
+	conftamerEnabled = true
+	conftamerJoinAddr = os.Getenv("CONFTAMER_JOIN") == "addr"
+}
+
+func conftamerOn() bool {
+	conftamerOnce.Do(conftamerInit)
+	return conftamerEnabled
+}
+
+// init prints a one-line diagnostic to stderr at process start whenever the
+// user opted in via CONFTAMER_EVENTS. It runs eagerly (not lazily on the first
+// hook) precisely so the "no events at all" case is self-explaining: if you set
+// CONFTAMER_EVENTS and a binary built with this toolchain runs, you WILL see
+// this line — its absence means the instrumented net/http was not linked (wrong
+// toolchain / cached test binary that didn't run). Silent when CONFTAMER_EVENTS
+// is unset, so ordinary programs are unaffected.
+func init() {
+	if os.Getenv("CONFTAMER_EVENTS") == "" {
+		return
+	}
+	if conftamerOn() {
+		mode := "id"
+		if conftamerJoinAddr {
+			mode = "addr"
+		}
+		fmt.Fprintf(os.Stderr, "conftamer: enabled — writing %q (join=%s)\n", conftamerPath, mode)
+	} else {
+		fmt.Fprintf(os.Stderr, "conftamer: CONFTAMER_EVENTS=%q set but open failed: %v\n", conftamerPath, conftamerOpenErr)
+	}
+}
+
+// --- event schema (mirrors contexttrack/client/main.go) --------------------
+
+type conftamerEvent struct {
+	Kind        string                `json:"kind"`
+	GoroutineID int                   `json:"goroutine_id"`
+	ThreadID    int                   `json:"thread_id"`
+	File        string                `json:"file"`
+	Line        int                   `json:"line"`
+	Message     map[string]string     `json:"message"`
+	Context     *conftamerContextInfo `json:"context"`
+	RequestID   *conftamerRequestID   `json:"request_id,omitempty"`
+	ApiId       string                `json:"api_id,omitempty"`
+	Pattern     string                `json:"pattern,omitempty"`
+}
+
+type conftamerRequestID struct {
+	Method string `json:"method"`
+	Host   string `json:"host"`
+	Path   string `json:"path"`
+}
+
+type conftamerContextInfo struct {
+	Source   string `json:"source,omitempty"`
+	Type     string `json:"type,omitempty"`
+	RootAddr string `json:"root_addr,omitempty"`
+	Error    string `json:"error,omitempty"`
+}
+
+// --- correlation join key --------------------------------------------------
+//
+// Default ("id" mode): an explicit, process-local, monotonically-increasing
+// request ID stamped into the request context at its origin (server ingress or
+// client Client.do) and inherited by every derived context. The join key for an
+// event is that ID, found by context.Value walking up the chain. This is
+// unique-per-origin (no scrape over-merge), traverses every context type (no
+// under-merge at WithoutCancel/custom wrappers), and never aliases (no
+// address-reuse false merge) — the three failure modes of the address walk.
+//
+// "addr" mode (CONFTAMER_JOIN=addr): the original Delve-faithful heap-address
+// walk (context.ConftamerRoot), kept for A/B regression comparison.
+
+// conftamerIDKey is the context.Value key for the stamped request ID. Its
+// unexported type makes it collision-proof.
+type conftamerIDKeyType struct{}
+
+var (
+	conftamerIDKey    conftamerIDKeyType
+	conftamerNextID   atomic.Uint64
+	conftamerJoinAddr bool // set from CONFTAMER_JOIN=addr in conftamerInit
+)
+
+// conftamerStampID returns ctx unchanged if it already carries an ID
+// (inherited from an ancestor), else a child context carrying a fresh
+// monotonic ID.
+func conftamerStampID(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if _, ok := ctx.Value(conftamerIDKey).(uint64); ok {
+		return ctx
+	}
+	return context.WithValue(ctx, conftamerIDKey, conftamerNextID.Add(1))
+}
+
+// conftamerStampIDIfOn is conftamerStampID gated on the logger being enabled,
+// so the ingress stamping edits stay a single expression and add zero overhead
+// when CONFTAMER_EVENTS is unset.
+func conftamerStampIDIfOn(ctx context.Context) context.Context {
+	if !conftamerOn() {
+		return ctx
+	}
+	return conftamerStampID(ctx)
+}
+
+// conftamerScopeStop reports whether a valueCtx key is one of net/http's own
+// connection/server-scoped keys (ServerContextKey, LocalAddrContextKey), which
+// use the unexported *contextKey type. The address walk must not cross these.
+func conftamerScopeStop(k any) bool {
+	_, ok := k.(*contextKey)
+	return ok
+}
+
+func conftamerContext(ctx context.Context) *conftamerContextInfo {
+	if ctx == nil {
+		return &conftamerContextInfo{Error: "nil context"}
+	}
+	root := "?"
+	if conftamerJoinAddr {
+		if a := context.ConftamerRoot(ctx, conftamerScopeStop); a != 0 {
+			root = "0x" + strconv.FormatUint(uint64(a), 16)
+		}
+	} else {
+		// id mode: inherited ID if present, else a fresh one (a direct
+		// Transport.RoundTrip origin with an un-tagged context — it has no
+		// Response-received event to match, so a fresh ID is correct).
+		id, ok := ctx.Value(conftamerIDKey).(uint64)
+		if !ok {
+			id = conftamerNextID.Add(1)
+		}
+		root = "id:" + strconv.FormatUint(id, 10)
+	}
+	return &conftamerContextInfo{
+		Source:   "req.Context()",
+		Type:     "context.Context",
+		RootAddr: root,
+	}
+}
+
+// --- caller identification (ported from caller_id.go) ----------------------
+
+var conftamerHTTPLayerPackages = map[string]bool{
+	"net/http":               true,
+	"golang.org/x/net/http2": true,
+}
+
+var conftamerMultiTenantHosts = map[string]bool{
+	"github.com":    true,
+	"gitlab.com":    true,
+	"bitbucket.org": true,
+}
+
+type conftamerCaller struct {
+	FuncName string
+	Package  string
+	ApiId    string
+}
+
+// conftamerPackageName extracts the import path from a runtime fully-qualified
+// function name, e.g. "github.com/prometheus/prometheus/scrape.(*x).scrape" ->
+// "github.com/prometheus/prometheus/scrape". Import paths may contain dots, so
+// the boundary is: drop any "[...]" generic suffix, find the last "/", then the
+// first "." after it.
+func conftamerPackageName(fullName string) string {
+	name := fullName
+	if start := strings.Index(name, "["); start >= 0 {
+		name = name[:start]
+	}
+	pathEnd := strings.LastIndex(name, "/")
+	if pathEnd < 0 {
+		pathEnd = 0
+	}
+	if dot := strings.Index(name[pathEnd:], "."); dot >= 0 {
+		return name[:pathEnd+dot]
+	}
+	return ""
+}
+
+// conftamerApiID derives an organization id from a package import path, e.g.
+// "github.com/prometheus/prometheus/scrape" -> "github.com/prometheus",
+// "k8s.io/client-go/rest" -> "k8s.io". Stdlib paths (no dot in the first
+// segment) are returned unchanged.
+func conftamerApiID(pkg string) string {
+	if pkg == "" {
+		return ""
+	}
+	segs := strings.SplitN(pkg, "/", 3)
+	if !strings.Contains(segs[0], ".") {
+		return pkg
+	}
+	if len(segs) >= 2 && conftamerMultiTenantHosts[segs[0]] {
+		return segs[0] + "/" + segs[1]
+	}
+	return segs[0]
+}
+
+// conftamerFindCaller walks the current goroutine's stack and returns the first
+// frame whose package is not an HTTP-layer package. The net/http hook site and
+// these helper frames are themselves in net/http, so they're skipped naturally.
+func conftamerFindCaller() *conftamerCaller {
+	var pcs [50]uintptr
+	n := runtime.Callers(2, pcs[:])
+	if n == 0 {
+		return nil
+	}
+	frames := runtime.CallersFrames(pcs[:n])
+	for {
+		f, more := frames.Next()
+		pkg := conftamerPackageName(f.Function)
+		if pkg != "" && !conftamerHTTPLayerPackages[pkg] {
+			return &conftamerCaller{FuncName: f.Function, Package: pkg, ApiId: conftamerApiID(pkg)}
+		}
+		if !more {
+			break
+		}
+	}
+	return nil
+}
+
+// --- metadata --------------------------------------------------------------
+
+func conftamerGoID() int {
+	var buf [64]byte
+	n := runtime.Stack(buf[:], false)
+	s := string(buf[:n])
+	s = strings.TrimPrefix(s, "goroutine ")
+	if i := strings.IndexByte(s, ' '); i >= 0 {
+		id, _ := strconv.Atoi(s[:i])
+		return id
+	}
+	return 0
+}
+
+// --- the logging entry point -----------------------------------------------
+
+// conftamerLog records one HTTP event. kind is one of "Request received",
+// "Request sent", "Response sent", "Response received". msg holds the extracted
+// message fields (keys match contexttrack/fmt.go). ctx is the request context
+// used for correlation. reqID (may be nil) is set for "Request sent"; withCaller
+// enables caller identification for the "sent" kinds.
+func conftamerLog(kind string, msg map[string]string, ctx context.Context, reqID *conftamerRequestID, withCaller bool) {
+	if !conftamerOn() {
+		return
+	}
+
+	_, file, line, _ := runtime.Caller(1)
+
+	ev := conftamerEvent{
+		Kind:        kind,
+		GoroutineID: conftamerGoID(),
+		File:        file,
+		Line:        line,
+		Message:     msg,
+		Context:     conftamerContext(ctx),
+	}
+
+	if withCaller {
+		if c := conftamerFindCaller(); c != nil {
+			ev.ApiId = c.ApiId
+			if kind == "Response sent" {
+				ev.Pattern = c.FuncName
+			}
+		}
+	}
+	if kind == "Request sent" {
+		ev.RequestID = reqID
+	}
+
+	linebytes, err := json.Marshal(ev)
+	if err != nil {
+		return
+	}
+	conftamerMu.Lock()
+	conftamerFile.Write(append(linebytes, '\n'))
+	conftamerMu.Unlock()
+}
