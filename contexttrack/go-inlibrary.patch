--- /dev/null
+++ b/home/tcr6/go-conftamer/src/net/http/conftamer.go
@@ -0,0 +1,544 @@
+// ConfTamer instrumentation embedded in net/http.
+//
+// At a handful of HTTP funnel points, records the message, resolves
+// the request context's conftamer ID, and tries to identify the "API ID"
+// (application-level caller).
+// A JSON object is appended to the file named by $CONFTAMER_EVENTS per event.
+// If $CONFTAMER_EVENTS is unset, every hook is a no-op.
+
+package http
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"reflect"
+	"runtime"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+var (
+	conftamerOnce    sync.Once
+	conftamerMu      sync.Mutex
+	conftamerFile    *os.File
+	conftamerEnabled bool
+	conftamerPath    string
+	conftamerOpenErr error
+)
+
+func conftamerInit() {
+	conftamerPath = os.Getenv("CONFTAMER_EVENTS")
+	if conftamerPath == "" {
+		return
+	}
+	f, err := os.OpenFile(conftamerPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
+	if err != nil {
+		conftamerOpenErr = err
+		return
+	}
+	conftamerFile = f
+	conftamerEnabled = true
+}
+
+func conftamerOn() bool {
+	conftamerOnce.Do(conftamerInit)
+	return conftamerEnabled
+}
+
+// init prints a one-line diagnostic to stderr at process start whenever the
+// user opted in via CONFTAMER_EVENTS.
+// It runs eagerly (not lazily on the first hook) to make it easy to differentiate
+// between "file exists but no events at all" and "file doesn't exist".
+func init() {
+	if os.Getenv("CONFTAMER_EVENTS") == "" {
+		return
+	}
+	if conftamerOn() {
+		fmt.Fprintf(os.Stderr, "conftamer: enabled — writing %q\n", conftamerPath)
+	} else {
+		fmt.Fprintf(os.Stderr, "conftamer: CONFTAMER_EVENTS=%q set but open failed: %v\n", conftamerPath, conftamerOpenErr)
+	}
+}
+
+// --- event schema --------------------
+
+type conftamerEvent struct {
+	Kind        string                `json:"kind"`
+	Ts          int64                 `json:"ts"` // Unix ns
+	Pid         int                   `json:"pid"`
+	GoroutineID int                   `json:"goroutine_id"`
+	ThreadID    int                   `json:"thread_id"`
+	File        string                `json:"file"`
+	Line        int                   `json:"line"`
+	Message     map[string]string     `json:"message"`
+	Context     *conftamerContextInfo `json:"context"`
+	RequestID   *conftamerRequestID   `json:"request_id,omitempty"`
+	ApiId       string                `json:"api_id,omitempty"`
+	// Handler is the name of the Handler serving a "Request received" event, or
+	// the Handler a ServeMux routed a "Request routed" event to.
+	// Not set on "Response sent".
+	Handler string `json:"handler,omitempty"`
+	// CallChain is the full stack at the event, innermost frame first, starting
+	// at the function that logged it.
+	CallChain []conftamerFrame `json:"call_chain,omitempty"`
+}
+
+// conftamerEnsureServerContext gives r a context ID, if it lacks one: a request
+// built by a server outside net/http without the ConftamerServerRequest hook.
+func conftamerEnsureServerContext(r *Request) *Request {
+	if !conftamerOn() {
+		return r
+	}
+	if _, ok := r.Context().Value(conftamerIDKey).(uint64); ok {
+		return r
+	}
+	return r.WithContext(conftamerStampID(r.Context()))
+}
+
+type conftamerFrame struct {
+	Function string `json:"function"`
+	File     string `json:"file"`
+	Line     int    `json:"line"`
+}
+
+type conftamerRequestID struct {
+	Method string `json:"method"`
+	Host   string `json:"host"`
+	Path   string `json:"path"`
+}
+
+type conftamerContextInfo struct {
+	Source    string `json:"source,omitempty"`
+	Type      string `json:"type,omitempty"`
+	ContextID string `json:"context_id,omitempty"`
+	Error     string `json:"error,omitempty"`
+}
+
+// --- context ID (correlation key) -----------------------------------------
+//
+// An explicit, process-local, monotonically-increasing request ID stamped
+// into the request context at its origin and inherited by every derived context.
+// conftamerIDKey is the context.Value key for the stamped request ID.
+// It's unexported to avoid colliding with other context.Value keys.
+type conftamerIDKeyType struct{}
+
+var (
+	conftamerIDKey  conftamerIDKeyType
+	conftamerNextID atomic.Uint64 // Next to assign
+)
+
+// conftamerStampID returns ctx unchanged if it already carries an ID
+// (inherited from an ancestor), else a child context carrying a fresh
+// monotonic ID.
+func conftamerStampID(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if _, ok := ctx.Value(conftamerIDKey).(uint64); ok {
+		return ctx
+	}
+	return context.WithValue(ctx, conftamerIDKey, conftamerNextID.Add(1))
+}
+
+// conftamerStampIDIfOn is conftamerStampID gated on the logger being enabled.
+func conftamerStampIDIfOn(ctx context.Context) context.Context {
+	if !conftamerOn() {
+		return ctx
+	}
+	return conftamerStampID(ctx)
+}
+
+func conftamerContext(ctx context.Context) *conftamerContextInfo {
+	if ctx == nil {
+		return &conftamerContextInfo{Error: "nil context"}
+	}
+	id, ok := ctx.Value(conftamerIDKey).(uint64)
+	if !ok {
+		id = conftamerNextID.Add(1)
+	}
+	return &conftamerContextInfo{
+		Source:    "req.Context()",
+		Type:      "context.Context",
+		ContextID: "id:" + strconv.FormatUint(id, 10),
+	}
+}
+
+// --- caller (API_ID) identification ----------------------
+
+// Generic HTTP plumbing (client wrappers, routers) that can't identify the API.
+// true: also skip subpackages and major versions (e.g. go-restful/v3).
+var conftamerHTTPLayerPackages = map[string]bool{
+	"net/http":                         false,
+	"net/http/httputil":                false,
+	"golang.org/x/net/http2":           false,
+	"golang.org/x/oauth2":              true,
+	"golang.org/x/net/context/ctxhttp": true,
+	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp": true,
+	"github.com/prometheus/common/route":                            true,
+	"github.com/emicklei/go-restful":                                true,
+	"github.com/gorilla/mux":                                        true,
+	"k8s.io/apiserver/pkg/server/mux":                               true,
+	"github.com/grafana/grafana/pkg/web":                            true,
+	"google.golang.org/grpc":                                        true,
+}
+
+func conftamerIsHTTPLayer(pkg string) bool {
+	for p, subpkgs := range conftamerHTTPLayerPackages {
+		if pkg == p || subpkgs && strings.HasPrefix(pkg, p+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+var conftamerMultiTenantHosts = map[string]bool{
+	"github.com":    true,
+	"gitlab.com":    true,
+	"bitbucket.org": true,
+}
+
+type conftamerCaller struct {
+	FuncName string
+	Package  string
+	ApiId    string
+}
+
+// tries to extract the import path from a runtime fully-qualified
+// function name, e.g. "github.com/prometheus/prometheus/scrape.(*x).scrape" ->
+// "github.com/prometheus/prometheus/scrape".
+// The boundary is: drop any "[...]" generic suffix, find the last "/", then the
+// first "." after it.
+func conftamerPackageName(fullName string) string {
+	name := fullName
+	if start := strings.Index(name, "["); start >= 0 {
+		name = name[:start]
+	}
+	pathEnd := strings.LastIndex(name, "/")
+	if pathEnd < 0 {
+		pathEnd = 0
+	}
+	if dot := strings.Index(name[pathEnd:], "."); dot >= 0 {
+		return name[:pathEnd+dot]
+	}
+	return ""
+}
+
+// Derives an API id from a package import path, e.g.
+// "github.com/prometheus/prometheus/scrape" -> "github.com/prometheus",
+// "k8s.io/client-go/rest" -> "k8s.io". Stdlib paths (no dot in the first
+// segment) returned unchanged.
+func conftamerApiID(pkg string) string {
+	if pkg == "" {
+		return ""
+	}
+	segs := strings.SplitN(pkg, "/", 3)
+	if !strings.Contains(segs[0], ".") {
+		return pkg
+	}
+	if len(segs) >= 2 && conftamerMultiTenantHosts[segs[0]] {
+		return segs[0] + "/" + segs[1]
+	}
+	return segs[0]
+}
+
+// Walks the current goroutine's stack and returns the first
+// frame whose package is not in "conftamerHTTPLayerPackages"
+// (inferred to be "generic helpers" and not the calling applciation).
+func conftamerFindCaller() *conftamerCaller {
+	var pcs [50]uintptr
+	n := runtime.Callers(2, pcs[:])
+	if n == 0 {
+		return nil
+	}
+	frames := runtime.CallersFrames(pcs[:n])
+	for {
+		f, more := frames.Next()
+		pkg := conftamerPackageName(f.Function)
+		if pkg != "" && !conftamerIsHTTPLayer(pkg) {
+			return &conftamerCaller{FuncName: f.Function, Package: pkg, ApiId: conftamerApiID(pkg)}
+		}
+		if !more {
+			break
+		}
+	}
+	return nil
+}
+
+// conftamerHandlerCaller identifies the API ID from a not-yet-invoked Handler
+// value. Used for "Request received", where the stack doesn't include the
+// application handler.
+func conftamerHandlerCaller(handler any) *conftamerCaller {
+	if handler == nil {
+		return nil
+	}
+   // get "real" type if this is stored as "any"
+	v := reflect.ValueOf(handler)
+	var pkg, name string
+	if v.Kind() == reflect.Func { // e.g., `http.HandlerFunc(...)`
+       // Get function pointer -> look up address in `runtime` to get func metadata
+		if fn := runtime.FuncForPC(v.Pointer()); fn != nil {
+			name = fn.Name()
+			pkg = conftamerPackageName(name)
+		}
+	} else { // e.g., method on a type
+		t := v.Type()
+		for t.Kind() == reflect.Ptr {
+			t = t.Elem()
+		}
+       // Look for package where type is defined
+		pkg = t.PkgPath()
+		name = t.String()
+	}
+	if pkg == "" || conftamerIsHTTPLayer(pkg) {
+		return nil
+	}
+	return &conftamerCaller{FuncName: name, Package: pkg, ApiId: conftamerApiID(pkg)}
+}
+
+// --- metadata --------------------------------------------------------------
+
+func conftamerGoID() int {
+	var buf [64]byte
+	n := runtime.Stack(buf[:], false)
+	s := string(buf[:n])
+	s = strings.TrimPrefix(s, "goroutine ")
+	if i := strings.IndexByte(s, ' '); i >= 0 {
+		id, _ := strconv.Atoi(s[:i])
+		return id
+	}
+	return 0
+}
+
+// conftamerCallChain returns every frame of the current goroutine's stack, innermost
+// first, skipping `skip` frames above its caller (0 = start at the caller).
+// The buffer grows until the whole stack fits, so deep stacks aren't truncated.
+func conftamerCallChain(skip int) []conftamerFrame {
+	pcs := make([]uintptr, 64)
+	var n int
+	for {
+		// +2 skips runtime.Callers and conftamerCallChain itself
+		n = runtime.Callers(skip+2, pcs)
+		if n < len(pcs) {
+			break
+		}
+		pcs = make([]uintptr, 2*len(pcs))
+	}
+	chain := make([]conftamerFrame, 0, n)
+	frames := runtime.CallersFrames(pcs[:n])
+	for {
+		f, more := frames.Next()
+		chain = append(chain, conftamerFrame{Function: f.Function, File: f.File, Line: f.Line})
+		if !more {
+			break
+		}
+	}
+	return chain
+}
+
+// --- logging entry point -----------------------------------------------
+
+// conftamerLog records one HTTP event. ctx is the context with ID used for correlation.
+// reqID (may be nil) is set for "Request sent". withCaller enables caller identification.
+// handler (non-nil only for "Request received" and "Request routed") is the not-yet-invoked
+// Handler about to serve the request — when set, it's used instead of a stack walk, since
+// the application handler isn't on the stack yet at that log point, and its name is
+// recorded as Handler.
+//
+// "Response sent" deliberately does NOT identify a caller: at the point a response is
+// written, the stack holds whatever the handler last called (fmt.Fprintln,
+// gzip.(*Writer).Write), not the handler itself, so the walk yields a misleading API.
+// Responses record only their code plus the method/path of the request they answer;
+// analysis (contexttrack/analysis/message_graph.py) recovers api_id/handler by matching
+// each response back to the "Request received" it answers, and the matched route pattern
+// from the "Request routed" events logged by conftamerLogRouted.
+func conftamerLog(kind string, msg map[string]string, ctx context.Context, reqID *conftamerRequestID, withCaller bool, handler any) {
+	conftamerLogAt(2, time.Now(), kind, msg, ctx, reqID, withCaller, handler)
+}
+
+// conftamerLogAt is conftamerLog for an event that happened at ts, logged by
+// the function skip frames up (1: conftamerLogAt's caller).
+func conftamerLogAt(skip int, ts time.Time, kind string, msg map[string]string, ctx context.Context, reqID *conftamerRequestID, withCaller bool, handler any) {
+	if !conftamerOn() {
+		return
+	}
+
+	_, file, line, _ := runtime.Caller(skip)
+
+	ev := conftamerEvent{
+		Kind:        kind,
+		Ts:          ts.UnixNano(),
+		Pid:         os.Getpid(),
+		GoroutineID: conftamerGoID(),
+		File:        file,
+		Line:        line,
+		Message:     msg,
+		Context:     conftamerContext(ctx),
+	}
+
+	if withCaller {
+		var c *conftamerCaller
+		if handler != nil {
+			c = conftamerHandlerCaller(handler)
+		} else {
+			c = conftamerFindCaller()
+		}
+		if c != nil {
+			ev.ApiId = c.ApiId
+			if handler != nil {
+				ev.Handler = c.FuncName
+			}
+		}
+	}
+	if kind == "Request sent" {
+		ev.RequestID = reqID
+	}
+	// Skip conftamerLog(At), so the chain starts at the function that logged
+	// the event (Transport.roundTrip, serverHandler.ServeHTTP, conftamerLogRouted, ...)
+	ev.CallChain = conftamerCallChain(skip)
+
+	linebytes, err := json.Marshal(ev)
+	if err != nil {
+		return
+	}
+	conftamerMu.Lock()
+	conftamerFile.Write(append(linebytes, '\n'))
+	conftamerMu.Unlock()
+}
+
+// conftamerLogRouted records the route pattern a ServeMux matched for r, logged from
+// ServeMux.ServeHTTP because that's the only point the pattern is reliably in hand:
+// "Request received" fires before any routing happens, and by "Response sent" a nested
+// mux's pattern has been written to a shallow request copy (see StripPrefix) that the
+// ResponseWriter's request never sees. Nested muxes each log, sharing the request's
+// context ID, so the last one recorded is the innermost — the most specific match.
+// An empty pattern (no route matched) is not logged.
+//
+// handler (may be nil) is what the pattern routes to: a Handler, or a router's own
+// handler type (any func or value works). When set, the API ID is identified from it,
+// as for "Request received": a server whose top-level Handler is a ServeMux gets no
+// API ID there (net/http is an HTTP-layer package), but the handler the mux
+// dispatches to is the application's.
+func conftamerLogRouted(pattern string, r *Request, handler any) {
+	if pattern == "" {
+		return
+	}
+	conftamerLog("Request routed", map[string]string{
+		"pattern":      pattern,
+		"req.Method":   r.Method,
+		"req.URL.Path": r.URL.Path,
+	}, r.Context(), nil, handler != nil, handler)
+}
+
+// ConftamerLogRouted records a route pattern matched by a router outside this
+// package — see conftamerLogRouted. Exported because a router such as
+// prometheus/common/route does its own matching, and can reach neither the
+// unexported logger nor the context ID it correlates on.
+// handler should be the application's handler for the route, not a wrapper the
+// router adds around it (middleware, instrumentation), so the API ID names the app.
+func ConftamerLogRouted(pattern string, r *Request, handler any) {
+	conftamerLogRouted(pattern, r, handler)
+}
+
+// Response received; as close as possible to socket.
+// No caller ID: read loop runs on its own goroutine, so api_id is not on stack.
+// r may be nil (HTTP/2 client stream carries only a context).
+func conftamerLogResponseWire(kind string, code int, ctx context.Context, r *Request) {
+	if !conftamerOn() {
+		return
+	}
+	codeKey := "code"
+	if kind == "Response received" {
+		codeKey = "resp.StatusCode"
+	}
+	msg := map[string]string{codeKey: strconv.Itoa(code)}
+	if r != nil {
+		msg["req.Method"] = r.Method
+		if r.URL != nil {
+			msg["req.URL.Path"] = r.URL.Path
+		}
+		if ctx == nil {
+			ctx = r.Context()
+		}
+	}
+	conftamerLog(kind, msg, ctx, nil, false, nil)
+}
+
+// --- hooks for HTTP implementations outside net/http ---------------------
+//
+// golang.org/x/net/http2's server and grpc-go's client (patched by
+// contexttrack/x-net-http2-server.sh and grpc-client.patch) can't reach the
+// unexported logger, so they log through these.
+
+// ConftamerStampContext returns ctx with a context ID (see conftamerStampID).
+func ConftamerStampContext(ctx context.Context) context.Context {
+	return conftamerStampIDIfOn(ctx)
+}
+
+// ConftamerServerRequest gives a request built outside net/http the context
+// ID that conn.readRequest gives net/http's. c (the connection it arrived on)
+// and h2Stream (its HTTP/2 stream) are recorded only with go-inlibrary-conn.patch.
+func ConftamerServerRequest(r *Request, c net.Conn, h2Stream uint32) *Request {
+	if !conftamerOn() {
+		return r
+	}
+	return r.WithContext(conftamerStampID(r.Context()))
+}
+
+// ConftamerLogRequestReceived logs "Request received" for a server outside
+// net/http, about to call handler. Not when handler is net/http's own (an
+// http.Server's TLSNextProto passes it), whose serverHandler.ServeHTTP logs it.
+func ConftamerLogRequestReceived(r *Request, handler Handler) {
+	switch handler.(type) {
+	case serverHandler, initALPNRequest:
+		return
+	}
+	conftamerLogAt(2, time.Now(), "Request received", map[string]string{
+		"req.Method":       r.Method,
+		"req.URL.Path":     r.URL.Path,
+		"req.URL.RawQuery": r.URL.RawQuery,
+	}, r.Context(), nil, true, handler)
+}
+
+// ConftamerLogResponseSent logs "Response sent" for a server outside net/http.
+func ConftamerLogResponseSent(r *Request, code int) {
+	if r == nil {
+		return
+	}
+	// No caller identification: see conftamerLog.
+	conftamerLogAt(2, time.Now(), "Response sent", map[string]string{
+		"code":         strconv.Itoa(code),
+		"req.Method":   r.Method,
+		"req.URL.Path": r.URL.Path,
+	}, r.Context(), nil, false, nil)
+}
+
+// ConftamerLogClientRequest logs "Request sent" for a client outside net/http
+// (grpc-go's). Its connection (local, remote) and HTTP/2 stream (h2Stream) are
+// recorded only with go-inlibrary-conn.patch.
+func ConftamerLogClientRequest(ctx context.Context, method, host, path string, local, remote net.Addr, h2Stream uint32) {
+	if !conftamerOn() {
+		return
+	}
+	conftamerLogAt(2, time.Now(), "Request sent", map[string]string{
+		"req.Method":       method,
+		"req.URL.Host":     host,
+		"req.URL.Path":     path,
+		"req.URL.RawQuery": "",
+	}, ctx, &conftamerRequestID{Method: method, Host: host, Path: path}, true, nil)
+}
+
+// ConftamerLogClientResponse logs "Response received" for a client outside
+// net/http. No caller ID: it's logged on the connection's reader goroutine.
+func ConftamerLogClientResponse(ctx context.Context, method, path string, code int) {
+	conftamerLogAt(2, time.Now(), "Response received", map[string]string{
+		"resp.StatusCode": strconv.Itoa(code),
+		"req.Method":      method,
+		"req.URL.Path":    path,
+	}, ctx, nil, false, nil)
+}
