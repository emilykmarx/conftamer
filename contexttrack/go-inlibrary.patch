--- /dev/null
+++ b/home/tcr6/go-conftamer/src/context/conftamer.go
@@ -0,0 +1,68 @@
+// ConfTamer instrumentation: in-process reimplementation of the context
+// parent-chain walk that contexttrack/ previously performed over Delve's RPC
+// (see contexttrack/context_finder.go: walkContextChain / parentPointers).
+//
+// Living inside package context gives direct access to the unexported parent
+// fields of the concrete context types, so the walk needs no reflection or
+// debugger. The net/http-scope stop rule is supplied by the caller as a
+// predicate over a valueCtx's key, so context needs no dependency on net/http.
+
+package context
+
+import "unsafe"
+
+// ConftamerRoot walks the parent chain starting from ctx, following the three
+// concrete context types the tracer understands — *valueCtx, *cancelCtx and
+// *timerCtx — and returns the address of the root (topmost reached) context as
+// a uintptr, or 0 if ctx is nil. The address is an opaque, process-stable join
+// key: two events whose contexts walk to the same root are correlated.
+//
+// The walk stops (without crossing) before a *valueCtx whose key satisfies
+// stop. net/http passes a stop that matches its own connection/server-scoped
+// keys (ServerContextKey, LocalAddrContextKey); crossing those would wrongly
+// unify every request on a connection — or the whole server — under one root.
+// The walk also stops at any context type it can't traverse (Background/TODO,
+// WithoutCancel, or a caller's custom wrapper), capped at 15 levels. These stop
+// conditions mirror contexttrack's original behavior exactly.
+func ConftamerRoot(ctx Context, stop func(key any) bool) uintptr {
+	if ctx == nil {
+		return 0
+	}
+	cur := ctx
+	curAddr := ctxAddr(cur)
+	for range 15 {
+		var parent Context
+		switch c := cur.(type) {
+		case *valueCtx:
+			parent = c.Context
+		case *cancelCtx:
+			parent = c.Context
+		case *timerCtx:
+			parent = c.cancelCtx.Context
+		default:
+			// Unknown / uncrossable context type — this is the root.
+			return curAddr
+		}
+		if parent == nil {
+			return curAddr
+		}
+		// If the parent is a net/http-scoped valueCtx, stop without crossing.
+		if vc, ok := parent.(*valueCtx); ok && stop != nil && stop(vc.key) {
+			return curAddr
+		}
+		cur = parent
+		curAddr = ctxAddr(cur)
+	}
+	return curAddr
+}
+
+// ctxAddr returns the address of the concrete value stored in the interface c.
+// For the pointer-typed contexts the walk crosses, this is the struct pointer
+// (matching the address Delve reported as root_addr). For a zero-size value
+// context (e.g. Background()), it is the shared zerobase address — the same
+// over-merging behavior the original Delve walk exhibited.
+func ctxAddr(c Context) uintptr {
+	// An interface value is a (type, data) word pair; the second word holds
+	// the pointer to (or the pointer-shaped value of) the concrete data.
+	return uintptr((*[2]unsafe.Pointer)(unsafe.Pointer(&c))[1])
+}
